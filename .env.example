# Biblioteca Virtual de Estudos Bíblicos — variáveis de ambiente
#
# Sem NEXT_PUBLIC_SUPABASE_URL/ANON_KEY definidas, a aplicação roda 100%
# sobre os dados mockados (src/lib/repositories/index.ts, DEC-023) — é
# assim que este ambiente de desenvolvimento roda por padrão. Defina as
# três variáveis abaixo só quando for de fato conectar a um projeto
# Supabase (local ou hospedado).
#
# Nunca commitar um .env real. Copie este arquivo para .env.local e
# preencha os valores.

# URL do projeto Supabase (painel do projeto > Settings > API, ou
# `npx supabase status` para o Postgres local).
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon/publishable) do Supabase — segura para uso no
# client. Lida por src/lib/supabase/client.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role/secret) — NUNCA expor no client, nunca
# usar em src/app/**, src/components/** ou src/lib/repositories/**.
# Usada só por src/lib/supabase/serviceClient.ts, que por sua vez só
# deve ser importado de scripts/ server-only (ex.: a pipeline de
# ingestão da Fase 3, src/lib/ingestion/supabaseIngestionRepository.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Proteção da área administrativa.
# Definir apenas no ambiente local/Vercel. Nunca commitar valores reais.
ADMIN_USERNAME=
ADMIN_PASSWORD=
