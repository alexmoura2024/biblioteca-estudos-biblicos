# Biblioteca Virtual de Estudos Bíblicos — variáveis de ambiente
#
# Nenhuma destas variáveis é lida por código ativo nesta fase (Marco 1 —
# protótipo com dados mockados, ver docs/WORK_STATUS.md). Elas documentam
# o que a Fase 2 (Supabase/PostgreSQL, docs/ROADMAP.md) vai precisar,
# para que a conexão futura não exija descobrir isso do zero.
#
# Nunca commitar um .env real. Copie este arquivo para .env.local e
# preencha os valores quando a Fase 2 começar.

# URL do projeto Supabase (painel do projeto > Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do Supabase — segura para uso no client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — NUNCA expor no client, apenas em
# código server-only (rotas de ingestão/administração da Fase 2+).
SUPABASE_SERVICE_ROLE_KEY=
